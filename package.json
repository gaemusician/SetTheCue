{
  "name": "setthecue",
  "productName": "SetTheCue",
  "version": "1.0.0",
  "private": true,
  "description": "A gig-ready setlist manager that flies Ableton Live arrangement playback over OSC.",
  "license": "AGPL-3.0-or-later",
  "author": "SetTheCue",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "a1": "electron electron/main.js",
    "a2": "node src/server.js",
    "a3": "bash build/generate-icons.sh",
    "a4": "electron-builder --dir",
    "a5": "electron-builder",
    "a6": "electron-builder --mac",
    "a7": "electron-builder --win",
    "a8": "electron-builder --mac --win"
  },
  "dependencies": {
    "osc": "^2.4.5",
    "qrcode": "^1.5.4",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "sortablejs": "^1.15.7"
  },
  "build": {
    "appId": "com.setthecue.app",
    "productName": "SetTheCue",
    "copyright": "\u00a9 2026 SetTheCue. Based on SetPilot by AshHenbrey (AGPL-3.0-or-later).",
    "npmRebuild": false,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "electron/**/*",
      "public/**/*",
      "package.json",
      "!**/node_modules/serialport/**",
      "!**/node_modules/@serialport/**"
    ],
    "extraResources": [
      {
        "from": "remote-script",
        "to": "remote-script",
        "filter": [
          "**/*",
          "!**/.DS_Store"
        ]
      },
      {
        "from": "LICENSE",
        "to": "licenses/LICENSE"
      },
      {
        "from": "THIRD-PARTY.md",
        "to": "licenses/THIRD-PARTY.md"
      },
      {
        "from": "THIRD-PARTY-LICENSES.txt",
        "to": "licenses/THIRD-PARTY-LICENSES.txt"
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.icns",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
